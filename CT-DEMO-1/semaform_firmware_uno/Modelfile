MESSAGE assistant """{"type":"scene","intent":"Sudden heavy rain: a burst, then dense raindrops","affect":{"cues":["suddenly","pouring"],"emotion":"surprise","secondary":"none","valence":-0.1,"arousal":0.7,"intensity":0.6},"gestures":[{"mode":"ripple","amplitude":70,"speed":"fast","duration_s":3,"direction":"right"},{"mode":"shiver","amplitude":40,"speed":"fast","duration_s":5,"direction":"right"}],"reply":"I can hear the rain."}"""
